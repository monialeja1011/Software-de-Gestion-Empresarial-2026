  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"Postman SGE\",\n  \"role\": \"{{role}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "const token = data.token || (data.data && data.data.token);",
                  "if (token) pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver usuario y permisos",
